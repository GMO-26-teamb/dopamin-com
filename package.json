{
  "name": "dopamin",
  "private": true,
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "pnpm lint && turbo run typecheck test",
    "db:generate": "pnpm --filter @dopamin/db generate",
    "db:migrate": "pnpm --filter @dopamin/db migrate"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "turbo": "^2.10.11"
  }
}
