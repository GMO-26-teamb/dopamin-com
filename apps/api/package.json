{
  "name": "@dopamin/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env.local src/dev.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:connect": "REGISTRY_CONNECT_TEST=1 vitest run test/connect/",
    "test:connect:transfer": "KITAQNIC_API_TRANSFER_TEST=1 vitest run test/connect/kitaqnic-transfer-api.connect.test.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.42",
    "@ai-sdk/google": "^4.0.51",
    "@dopamin/db": "workspace:*",
    "@dopamin/registry": "workspace:*",
    "@dopamin/shared": "workspace:*",
    "@hono/zod-validator": "^0.9.0",
    "@simplewebauthn/server": "^13.3.2",
    "ai": "^7.0.79",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.4",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@dopamin/tsconfig": "workspace:*",
    "@electric-sql/pglite": "0.5.7",
    "@hono/node-server": "^2.1.1",
    "@types/node": "^22",
    "@vitest/coverage-v8": "4.1.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
