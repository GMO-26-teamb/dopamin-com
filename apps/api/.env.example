# ローカル開発用（.env.local にコピー。git 管理外）
PORT=8787

# Supabase（Transaction pooler, ポート 6543 の接続文字列。docs/requirements.md §16.3 / §17）
DATABASE_URL=
# マイグレーション用（直結 or Supavisor session mode、ポート 5432）。pnpm db:generate / db:migrate（drizzle-kit）が使う
# CI / 本番デプロイでは GitHub Secrets に session mode の URL を入れる（直結は IPv6 のみ。§16.3）
DIRECT_DATABASE_URL=

# WebAuthn（FR-01 spec §6）
# ローカルは localhost 固定。127.0.0.1 でアクセスすると RP ID 不一致で失敗する
# 本番: WEBAUTHN_RP_ID=dopamin.ut42tech.com / WEBAUTHN_ORIGIN=https://dopamin.ut42tech.com（§16.1）
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ドパ民.com
WEBAUTHN_ORIGIN=http://localhost:3000

# レジストリ（§17）。real / mock
REGISTRY_MODE=mock
# mock レジストリのエラーシミュレーション:
#   none / timeout / 5xx / reject / spec_mismatch
#   timeout_after_write = 更新系だけ「レジストリには届いたが応答がタイムアウト」にする
#                         （参照系は通るので、AC-18-2 の info 照合を手元で確認できる）
MOCK_REGISTRY_FAIL_MODE=none
# Kitaqsign
KITAQSIGN_BASE_URL=https://epp.kitaqsign.com
KITAQSIGN_GATE_USER=
KITAQSIGN_GATE_PASSWORD=
KITAQSIGN_REGISTRAR_ID=
KITAQSIGN_API_KEY=

# Kitaqnic
KITAQNIC_BASE_URL=https://epp.kitaqnic.com
KITAQNIC_GATE_USER=
KITAQNIC_GATE_PASSWORD=
KITAQNIC_REGISTRAR_ID=
KITAQNIC_API_KEY=

# mock レジストリの移管シミュレーション（§11 / §17）。REGISTRY_MODE=mock のときのみ使う
# 相手レジストラ ID（未設定可）
MOCK_FOREIGN_REGISTRAR_ID=
# 自動承認までのミリ秒。既定 20 分（1200000ms）。テストでは短縮する
MOCK_TRANSFER_AUTO_APPROVE_MS=1200000

# 生成 AI（§13.1）。既定は Google AI Studio の無料枠
AI_PROVIDER=google
# 使うモデル ID（プロバイダに合わせて設定。値は運用側で決定するため既定なし）
AI_MODEL=
# 埋め込みモデル（§13.3）。値域は AI_PROVIDER と同じ
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=
# プロバイダ API キー（秘密情報。クライアントに出さない。NFR-03）
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=

# 独自性スコアの較正値（§14.2）。検証セットで較正済みの初期値
UNIQUENESS_THETA_LOW=0.05
UNIQUENESS_THETA_HIGH=0.45

# GitHub REST API（公開リポ取得のレート制限緩和、読み取りのみのスコープ。秘密情報）
GITHUB_TOKEN=

# true で FR-16（デモデータリセット）を有効化する。それ以外の値は false 扱い
DEMO_RESET_ENABLED=false

# ログレベル（NFR-06）。info / debug
LOG_LEVEL=info
