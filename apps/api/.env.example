# ローカル開発用（.env.local にコピー。git 管理外）
PORT=8787

# Supabase（Transaction pooler, ポート 6543 の接続文字列。docs/requirements.md §16.3 / §17）
DATABASE_URL=
# マイグレーション用（直結 or Supavisor session mode、ポート 5432）。pnpm db:generate / db:migrate（drizzle-kit）が使う
# CI / 本番デプロイでは GitHub Secrets に session mode の URL を入れる（直結は IPv6 のみ。§16.3）
DIRECT_DATABASE_URL=

# WebAuthn（FR-01 spec §6）
# ローカルは localhost 固定。127.0.0.1 でアクセスすると RP ID 不一致で失敗する
# 本番: WEBAUTHN_RP_ID=dopamin.ut42tech.com / WEBAUTHN_ORIGIN=https://dopamin.ut42tech.com（§16.1）
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ドパ民.com
WEBAUTHN_ORIGIN=http://localhost:3000

# レジストリ（§17）。real / mock
REGISTRY_MODE=mock
# mock レジストリのエラーシミュレーション:
#   none / timeout / 5xx / reject / spec_mismatch
#   timeout_after_write = 更新系だけ「レジストリには届いたが応答がタイムアウト」にする
#                         （参照系は通るので、AC-18-2 の info 照合を手元で確認できる）
MOCK_REGISTRY_FAIL_MODE=none
# Kitaqsign
KITAQSIGN_BASE_URL=https://epp.kitaqsign.com
KITAQSIGN_GATE_USER=
KITAQSIGN_GATE_PASSWORD=
KITAQSIGN_REGISTRAR_ID=
KITAQSIGN_API_KEY=

# Kitaqnic
KITAQNIC_BASE_URL=https://epp.kitaqnic.com
KITAQNIC_GATE_USER=
KITAQNIC_GATE_PASSWORD=
KITAQNIC_REGISTRAR_ID=
KITAQNIC_API_KEY=

# mock レジストリの移管シミュレーション（§11 / §17）。REGISTRY_MODE=mock のときのみ使う
# 相手レジストラ ID（未設定可）
MOCK_FOREIGN_REGISTRAR_ID=
# 自動承認までのミリ秒。既定 20 分（1200000ms）。テストでは短縮する
MOCK_TRANSFER_AUTO_APPROVE_MS=1200000

# 生成 AI（§13.1）。既定プロバイダ: google / anthropic / xai
# 値域は packages/shared の AI_PROVIDERS が正。xai（Grok）は Gateway 経由専用なので
# AI_GATEWAY_API_KEY が無い環境では選択肢に出ない（docs/specs/ai-gateway.md §2.6）
AI_PROVIDER=google
# 使うモデル ID（未設定なら各プロバイダの既定: google=gemini-2.5-flash /
# anthropic=claude-sonnet-4-5 / xai=grok-4.1-fast-non-reasoning。
# 一覧は apps/api/src/services/settings.ts の KNOWN_MODELS）
AI_MODEL=
# プロバイダ API キー（秘密情報。クライアントに出さない。NFR-03）
GOOGLE_GENERATIVE_AI_API_KEY=
ANTHROPIC_API_KEY=
# Vercel AI Gateway のキー（秘密情報）。上の固有キーが無いときだけ使われ、
# これ 1 本で google / anthropic / xai すべてに出せる。
# **固有キーも Gateway キーも無いと AI 機能（FR-04 / FR-13）が丸ごと 503 になる**
AI_GATEWAY_API_KEY=

# GitHub 解析（FR-13）。real / mock。mock はネットワークに出ずフェイク応答を返す
GITHUB_MODE=mock
# GITHUB_MODE=mock のときの失敗シミュレーション: none / not_found / rate_limited / unreachable
GITHUB_MOCK_FAIL_MODE=none
# GitHub REST API（公開リポ取得。読み取りのみのスコープ = public_repo すら不要。秘密情報）
# **GITHUB_MODE=real では実質必須**。未設定でも公開リポは読めるが未認証は 60 req/h で、
# 1 提案あたり最大 6 リクエスト投げるため 1 時間に約 10 提案で 429（RATE_LIMITED）に達し、
# 以降の提案生成が全滅する。未設定のまま real にすると起動後の初回呼び出しで警告ログが出る
GITHUB_TOKEN=

# true で FR-16（デモデータリセット）を有効化する。それ以外の値は false 扱い
DEMO_RESET_ENABLED=false

# ログレベル（NFR-06）。info / debug
LOG_LEVEL=info
