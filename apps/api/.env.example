# ローカル開発用（.env.local にコピー。git 管理外）
PORT=8787

# Supabase（Transaction pooler, ポート 6543 の接続文字列。docs/requirements.md §16.3 / §17）
DATABASE_URL=

# WebAuthn（FR-01 spec §6）
# ローカルは localhost 固定。127.0.0.1 でアクセスすると RP ID 不一致で失敗する
# 本番: WEBAUTHN_RP_ID=dopamin.ut42tech.com / WEBAUTHN_ORIGIN=https://dopamin.ut42tech.com（§16.1）
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=ドパ民.com
WEBAUTHN_ORIGIN=http://localhost:3000

# レジストリ（§17）。real / mock
REGISTRY_MODE=mock
# Kitaqsign
KITAQSIGN_BASE_URL=https://epp.kitaqsign.com
KITAQSIGN_GATE_USER=
KITAQSIGN_GATE_PASSWORD=
KITAQSIGN_REGISTRAR_ID=
KITAQSIGN_API_KEY=

# Kitaqnic
KITAQNIC_BASE_URL=https://epp.kitaqnic.com
KITAQNIC_GATE_USER=
KITAQNIC_GATE_PASSWORD=
KITAQNIC_REGISTRAR_ID=
KITAQNIC_API_KEY=
