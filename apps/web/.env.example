# .env.local にコピーして使う（git 管理外）
# rewrites の転送先。サーバー専用（ブラウザには露出しない）
API_ORIGIN=http://localhost:8787
NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000

# データ取得の実装切替（fe-ui 設計 §1、解決は apps/web/lib/api/mode.ts）
#   mock = 既定（未設定も mock）。ブラウザ内のモックサービスを使い、proxy.ts の認証チェックも素通しする
#   http = 実 API（同一オリジンの /api/v1/* を Hono RPC で叩く）
#   上記以外の値は例外にする（綴り違いで認証チェックが消えないように）
NEXT_PUBLIC_API_MODE=mock
